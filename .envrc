# shellcheck shell=bash

# Nix's flake archive needs an explicit ref for a clean detached checkout.
if git diff --quiet HEAD -- 2>/dev/null && ! git symbolic-ref --quiet HEAD >/dev/null; then
  watch_file flake.nix flake.lock "$(git rev-parse --git-path HEAD)"
  use flake './?ref=HEAD'
else
  use flake
fi
