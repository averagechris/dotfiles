; Eww configuration for Hyprland bar
; Rose Pine Moon themed

; Variables
(defpoll time :interval "1s" "date '+%I:%M %p'")
(defpoll date :interval "60s" "date '+%a %b %d'")
(defpoll battery :interval "30s" "cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo 100")
(defpoll battery-status :interval "30s" "cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo 'Full'")
(defpoll volume :interval "1s" "pamixer --get-volume 2>/dev/null || echo 0")
(defpoll volume-muted :interval "1s" "pamixer --get-mute 2>/dev/null || echo false")
(defpoll audio-output :interval "2s" "audio-output eww-label 2>/dev/null || echo '󰕾 OUT'")
(defpoll brightness :interval "1s" "brightnessctl -m | cut -d',' -f4 | tr -d '%' 2>/dev/null || echo 100")
(defpoll wifi-ssid :interval "10s" "nmcli -t -f active,ssid dev wifi | grep '^yes' | cut -d':' -f2 || echo 'Disconnected'")
(defpoll bluetooth-connected :interval "10s" "bluetoothctl info 2>/dev/null | grep -q 'Connected: yes' && echo true || echo false")
(defpoll keyboard-layout :interval "2s" "hyprctl devices -j 2>/dev/null | jq -r '.keyboards[] | select(.main == true) | .active_keymap' | cut -d'(' -f2 | cut -d')' -f1 || echo 'us'")
(defpoll home-display-state :interval "2s" "command -v tater-home-toggle >/dev/null && hyprctl monitors -j 2>/dev/null | jq -r 'if any(.[]; .name == \"DP-2\" and .model == \"DELL U4320Q\" and ((.disabled // false) | not)) then if any(.[]; .name == \"eDP-1\" and ((.disabled // false) | not)) then \"open\" else \"clamshell\" end else \"absent\" end' || echo absent")
(defpoll idle-inhibit-state :interval "2s" "command -v dotfiles-idle-inhibit >/dev/null && dotfiles-idle-inhibit status || echo unavailable")
(defpoll hctl-workspace-label :interval "1s" "state=\"''${XDG_STATE_HOME:-$HOME/.local/state}/hctl/eww-state.json\"; jq -r 'if .activeWorkspace.kind == \"named\" and (.activeWorkspace.name | test(\"^[0-9]+$\") | not) then .activeWorkspace.name + (if .activeWorkspace.empty then \" ∅\" else \" \" + (.activeWorkspace.windowCount|tostring) end) elif .activeWorkspace.kind == \"special\" then \"special:\" + .activeWorkspace.name + (if .activeWorkspace.empty then \" ∅\" else \" \" + (.activeWorkspace.windowCount|tostring) end) else empty end' \"$state\" 2>/dev/null || true")
(defpoll hctl-keepass-state :interval "1s" "state=\"''${XDG_STATE_HOME:-$HOME/.local/state}/hctl/eww-state.json\"; jq -r '.apps.keepassxc as $app | if ($app.running // false) then if ($app.mapped // false) then \"mapped\" else \"tray\" end else \"stopped\" end' \"$state\" 2>/dev/null || echo unavailable")
(defpoll hctl-chat-state :interval "1s" "state=\"''${XDG_STATE_HOME:-$HOME/.local/state}/hctl/eww-state.json\"; jq -r '[if (.apps.signal.borrowed // false) then \"S\" else empty end, if (.apps.telegram.borrowed // false) then \"T\" else empty end] | if length > 0 then \"borrowed \" + join(\"/\") else \"home\" end' \"$state\" 2>/dev/null || echo unavailable")

; Workspaces (updated via hyprland IPC)
(deflisten workspaces :initial "[1]" "scripts/workspaces.sh")
(deflisten active-workspace :initial "1" "scripts/active-workspace.sh")
(deflisten workspaces-internal :initial "[1]" "scripts/workspaces.sh eDP-1")
(deflisten active-workspace-internal :initial "1" "scripts/active-workspace.sh eDP-1")
(deflisten workspaces-external :initial "[6]" "scripts/workspaces.sh DP-2")
(deflisten active-workspace-external :initial "6" "scripts/active-workspace.sh DP-2")
(deflisten workspaces-external-dp1 :initial "[6]" "scripts/workspaces.sh DP-1")
(deflisten active-workspace-external-dp1 :initial "6" "scripts/active-workspace.sh DP-1")
(deflisten workspaces-external-dp3 :initial "[6]" "scripts/workspaces.sh DP-3")
(deflisten active-workspace-external-dp3 :initial "6" "scripts/active-workspace.sh DP-3")
(deflisten workspaces-external-hdmi-a-1 :initial "[6]" "scripts/workspaces.sh HDMI-A-1")
(deflisten active-workspace-external-hdmi-a-1 :initial "6" "scripts/active-workspace.sh HDMI-A-1")
(deflisten workspaces-external-hdmi-a-2 :initial "[6]" "scripts/workspaces.sh HDMI-A-2")
(deflisten active-workspace-external-hdmi-a-2 :initial "6" "scripts/active-workspace.sh HDMI-A-2")
(deflisten current-submap :initial "" "scripts/submap.sh")

; Media
(defpoll media-title :interval "1s" "playerctl metadata title 2>/dev/null || echo ''")
(defpoll media-artist :interval "1s" "playerctl metadata artist 2>/dev/null || echo ''")
(defpoll media-status :interval "1s" "playerctl status 2>/dev/null || echo 'Stopped'")

; Widgets
(defwidget workspaces-widget [items active]
  (box :class "workspaces" :orientation "h" :space-evenly false
    (for ws in items
      (button :class {ws == active ? "workspace active" : "workspace"}
              :onclick "hyprctl dispatch workspace ${ws}"
        ws))))

(defwidget submap-widget []
  (button :class "submap ${current-submap != '' ? 'active' : ''}"
       :visible {current-submap != ""}
       :onclick "eww-hyprland-keybindings-help"
       :tooltip {current-submap == "resize" ? "Resize mode: M shrink width, N grow height, E shrink height, I grow width, Esc exit" :
                 current-submap == "scratchpad" ? "Scratch mode: T terminal, Shift+T move terminal, S scratchpad, Shift+S move scratchpad, K/P KeePassXC, Esc exit" :
                 current-submap == "chat" ? "Chat mode: C chat workspace, S borrow/return Signal, T borrow/return Telegram, Esc exit" :
                  current-submap == "windowactions" ? "Window mode: V smart video pin, Z zen window, P toggle pin, G smart gaps, Esc exit" :
                 current-submap == "quickactions" ? "Actions mode: S Signal, T Telegram, K KeePassXC, B Zen, O Obsidian, L lock, H/? help, Esc exit" :
                 "Active submap/mode: ${current-submap}"}
     (label :text {current-submap == "resize" ? "󰩨 RESIZE" :
                    current-submap == "scratchpad" ? "󰗼 SCRATCH" :
                    current-submap == "chat" ? "󰍡 CHAT" :
                    current-submap == "windowactions" ? "󰖲 WINDOW" :
                    current-submap == "quickactions" ? "󰍜 ACTIONS" :
                    current-submap})))

(defwidget hctl-workspace-widget []
  (box :class "hctl-workspace ${hctl-workspace-label != '' ? 'active' : ''}"
       :orientation "h" :space-evenly false
       :visible {hctl-workspace-label != ""}
       :tooltip "hctl workspace state"
    (label :text "󰒲")
    (label :text hctl-workspace-label)))

(defwidget hctl-chat-widget []
  (button :class "hctl-chat ${hctl-chat-state}"
          :visible {hctl-chat-state != "unavailable"}
          :onclick "hctl goto chat"
          :onmiddleclick "hctl toggle-borrow signal"
          :onrightclick "hctl toggle-borrow telegram"
          :tooltip {hctl-chat-state == "home" ? "Chat apps are home; left click chat workspace, middle borrow Signal, right borrow Telegram" : "Chat app borrowed: ${hctl-chat-state}; left click chat workspace"}
    {hctl-chat-state == "home" ? "󰍡" : "󰍡 ${hctl-chat-state}"}))

(defwidget hctl-keepass-widget []
  (button :class "hctl-keepass ${hctl-keepass-state}"
          :visible {hctl-keepass-state != "unavailable"}
          :onclick "hctl summon keepassxc"
          :onrightclick "hctl hide keepassxc"
          :tooltip {hctl-keepass-state == "mapped" ? "KeePassXC visible; right click to hide to tray" : hctl-keepass-state == "tray" ? "KeePassXC in tray; click to summon" : "KeePassXC stopped; click to launch"}
    {hctl-keepass-state == "mapped" ? "󰌾" : hctl-keepass-state == "tray" ? "󰌾•" : "󰌾×"}))

(defwidget clock []
  (box :class "clock" :orientation "h" :space-evenly false
    (label :text time)))

(defwidget date-widget []
  (box :class "date" :orientation "h" :space-evenly false
    (label :text date)))

(defwidget battery-widget []
  (box :class "battery ${battery-status == 'Charging' ? 'charging' : ''}" 
       :orientation "h" :space-evenly false
       :tooltip "Battery: ${battery}% (${battery-status})"
    (label :text {battery < 20 ? "󰁺" : 
                  battery < 40 ? "󰁼" : 
                  battery < 60 ? "󰁾" : 
                  battery < 80 ? "󰂀" : "󰁹"})
    (label :text "${battery}%")))

(defwidget volume-widget []
  (eventbox :onclick "pamixer -t"
            :onrightclick "audio-output menu"
            :onscroll "scripts/volume-scroll.sh {}"
    (box :class "volume ${volume-muted == 'true' ? 'muted' : ''}" 
          :orientation "h" :space-evenly false
          :tooltip "Volume: ${volume}% — left click mute, right click cycle output, scroll adjust"
      (label :text {volume-muted == "true" ? "󰝟" : 
                     volume < 30 ? "󰕿" : 
                     volume < 70 ? "󰖀" : "󰕾"})
      (label :text "${volume}%")
      (button :class "audio-output"
              :onclick "audio-output cycle"
              :tooltip "Output: ${audio-output} — click to cycle, right-click to choose output"
        audio-output))))

(defwidget brightness-widget []
  (eventbox :onscroll "scripts/brightness-scroll.sh {}"
    (box :class "brightness" :orientation "h" :space-evenly false
         :tooltip "Brightness: ${brightness}%"
      (label :text {brightness < 30 ? "󰃞" : 
                    brightness < 70 ? "󰃟" : "󰃠"})
      (label :text "${brightness}%"))))

(defwidget network-widget []
  (eventbox :onclick "nm-connection-editor &"
    (box :class "network" :orientation "h" :space-evenly false
         :tooltip "WiFi: ${wifi-ssid} (click to manage)"
      (label :text {wifi-ssid == "Disconnected" ? "󰤭" : "󰤨"})
      (label :text wifi-ssid :limit-width 15))))

(defwidget bluetooth-widget []
  (eventbox :onclick "overskride &"
    (box :class "bluetooth ${bluetooth-connected == 'true' ? 'connected' : ''}"
         :orientation "h" :space-evenly false
         :tooltip "Bluetooth (click to manage)"
      (label :text {bluetooth-connected == "true" ? "󰂯" : "󰂲"}))))

(defwidget keyboard-widget []
  (box :class "keyboard"
       :orientation "h" :space-evenly false
       :tooltip "Keyboard layout"
    (label :text {keyboard-layout == "us" ? "󰌌 US" :
                  keyboard-layout == "basic" ? "󰌌 QW" :
                   keyboard-layout == "colemak_dh" ? "󰌌 CM" : "󰌌 ${keyboard-layout}"})))

(defwidget home-display-widget []
  (button :class "home-display ${home-display-state}"
          :visible {home-display-state != "absent"}
          :onclick "tater-home-toggle"
          :tooltip {home-display-state == "open" ? "Dell + laptop panel active; click for Dell-only clamshell" : "Dell-only clamshell active; click to enable laptop panel"}
    {home-display-state == "open" ? "󰌢+󰍹" : "󰍹"}))

(defwidget idle-inhibit-widget []
  (button :class "idle-inhibit ${idle-inhibit-state}"
          :visible {idle-inhibit-state != "unavailable"}
          :onclick "dotfiles-idle-inhibit toggle"
          :tooltip {idle-inhibit-state == "active" ? "Idle lock/sleep inhibited for the current power/lid/display state; click to clear" : "Click to prevent automatic dim, lock, display-off, suspend, and hibernate until power/lid/display state changes"}
    {idle-inhibit-state == "active" ? "󰅶" : "󰾪"}))

(defwidget media-widget []
  (box :class "media ${media-status}" :orientation "h" :space-evenly false
       :visible {media-title != ""}
    (button :onclick "playerctl previous" "󰒮")
    (button :onclick "playerctl play-pause" 
      {media-status == "Playing" ? "󰏤" : "󰐊"})
    (button :onclick "playerctl next" "󰒭")
    (label :text "${media-artist} - ${media-title}" :limit-width 30)))

(defwidget power-button []
  (button :class "power" :onclick "scripts/power-menu.sh" "󰐥"))

; Bar sections
(defwidget left [items active]
  (box :class "left" :orientation "h" :space-evenly false :halign "start"
    (workspaces-widget :items items :active active)
    (hctl-workspace-widget)
    (submap-widget)))

(defwidget center []
  (box :class "center" :orientation "h" :space-evenly false :halign "center"
    (media-widget)))

(defwidget right []
  (box :class "right" :orientation "h" :space-evenly false :halign "end"
    (keyboard-widget)
    (home-display-widget)
    (idle-inhibit-widget)
    (hctl-chat-widget)
    (hctl-keepass-widget)
    (network-widget)
    (bluetooth-widget)
    (brightness-widget)
    (volume-widget)
    (battery-widget)
    (date-widget)
    (clock)
    (power-button)))

(defwidget bar [items active]
  (centerbox :class "bar"
    (left :items items :active active)
    (center)
    (right)))

; Windows
(defwindow bar-internal
  :monitor "eDP-1"
  :geometry (geometry :x "0%" :y "4px" :width "99%" :height "32px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :items workspaces-internal :active active-workspace-internal))

(defwindow bar-external
  :monitor "DP-2"
  :geometry (geometry :x "0%" :y "4px" :width "99%" :height "32px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :items workspaces-external :active active-workspace-external))

(defwindow bar-external-dp1
  :monitor "DP-1"
  :geometry (geometry :x "0%" :y "4px" :width "99%" :height "32px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :items workspaces-external-dp1 :active active-workspace-external-dp1))

(defwindow bar-external-dp3
  :monitor "DP-3"
  :geometry (geometry :x "0%" :y "4px" :width "99%" :height "32px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :items workspaces-external-dp3 :active active-workspace-external-dp3))

(defwindow bar-external-hdmi-a-1
  :monitor "HDMI-A-1"
  :geometry (geometry :x "0%" :y "4px" :width "99%" :height "32px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :items workspaces-external-hdmi-a-1 :active active-workspace-external-hdmi-a-1))

(defwindow bar-external-hdmi-a-2
  :monitor "HDMI-A-2"
  :geometry (geometry :x "0%" :y "4px" :width "99%" :height "32px" :anchor "top center")
  :stacking "fg"
  :exclusive true
  :focusable false
  (bar :items workspaces-external-hdmi-a-2 :active active-workspace-external-hdmi-a-2))
