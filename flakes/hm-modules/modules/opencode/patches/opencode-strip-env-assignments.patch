@@ -170,4 +170,23 @@ export const scan = Effect.fnUntraced(function* (
   return yield* scanLegacy(command, shell, cwd)
 })
 
+function permissionResource(node: Node) {
+  const base = node.parent?.type === "redirected_statement" ? node.parent : node
+  let lastAssignment: ReturnType<typeof node.child> = null
+  for (let i = 0; i < node.childCount; i++) {
+    const child = node.child(i)
+    if (!child || child.type !== "variable_assignment") break
+    // Assignments can run substitutions before the command. Keep the complete
+    // source in that case so a command allow rule cannot authorize the prefix.
+    if (
+      child.descendantsOfType("command_substitution").length > 0 ||
+      child.descendantsOfType("process_substitution").length > 0
+    )
+      return base.text.trim()
+    lastAssignment = child
+  }
+  if (!lastAssignment) return base.text.trim()
+  return base.text.slice(lastAssignment.endIndex - base.startIndex).trim()
+}
