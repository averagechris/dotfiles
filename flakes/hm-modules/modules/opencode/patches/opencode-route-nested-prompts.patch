+    const sessions = [
+      session("root"),
+      session("child", "root"),
+      session("grandchild", "child"),
+      session("sibling", "root"),
+      session("other"),
+      session("other-child", "other"),
+    ]
+
+    expect(collectSessionSubtree(sessions, "root").map((item) => item.id)).toEqual([
+      "root",
+      "child",
+      "sibling",
+      "grandchild",
+    ])
+  })
+
+  test("returns an empty array when the root is missing", () => {
+    expect(collectSessionSubtree([session("child", "root")], "root")).toEqual([])
+  })
+
+  test("guards against malformed parent cycles", () => {
+    const sessions = [session("root", "child"), session("child", "root")]
+
+    expect(collectSessionSubtree(sessions, "root").map((item) => item.id)).toEqual(["root", "child"])
+  })
